           RowBox[{";;", ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "x", ",", 
           RowBox[{"x", "^", "2"}], ",", 
           RowBox[{"x", "^", "3"}]}], 
          RowBox[{"(*", 
           RowBox[{",", 
            RowBox[{"x", "^", "4"}]}], "*)"}], "}"}], ",", "x", ",", 
         RowBox[{"Weights", "\[Rule]", 
          RowBox[{"1", "/", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "4"}], "]"}], "]"}], "^", "2"}]}]}], ",", 
         RowBox[{"VarianceEstimatorFunction", "\[Rule]", 
          RowBox[{"(", 
           RowBox[{"1", "&"}], ")"}]}]}], "]"}], "&"}], "/@", 
      "md2listlen"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"qdlist", "=", 
     RowBox[{"ReadList", "[", 
      RowBox[{
       RowBox[{"dir", "<>", "\"\<Rv.txt\>\""}], ",", "Number"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"qdlist", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"qdlist", ",", 
       RowBox[{"{", "4", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lenlist", "=", 
     RowBox[{"{", 
      RowBox[{
      "18", ",", "24", ",", "30", ",", "36", ",", "48", ",", "60", ",", "72", 
       ",", "96"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"qdlist1", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"qdlist", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", 
             RowBox[{"lenlist", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "\[LessEqual]", 
           "0.0001"}], "&"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "lenlist", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"qdfine", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"#", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"0.2599", "\[LessEqual]", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "\[LessEqual]", "0.3501"}], "&&", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "-", "0.315"}], "]"}], 
             "\[GreaterEqual]", "0.0001"}]}], ")"}], "&"}]}], "]"}], "&"}], "/@",
       "qdlist1"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DvSamples", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"shift", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"RandomVariate", "[", 
            RowBox[{
             RowBox[{"NormalDistribution", "[", "]"}], ",", 
             RowBox[{"Length", "[", 
              RowBox[{"qdfine", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "qdfine", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sample", "=", "qdfine"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"sample", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", ";;", ",", "3"}], "]"}], "]"}], "=", 
         RowBox[{
          RowBox[{"qdfine", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", ";;", ",", "3"}], "]"}], "]"}], "+", 
          RowBox[{
           RowBox[{"qdfine", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", ";;", ",", "4"}], "]"}], "]"}], "*", 
           "shift"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"qdfitSample", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"LinearModelFit", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "x"}], 
              RowBox[{"(*", 
               RowBox[{",", 
                RowBox[{"x", "^", "2"}]}], "*)"}], "}"}], ",", "x", ",", 
             RowBox[{"Weights", "\[Rule]", 
              RowBox[{"1", "/", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{";;", ",", "4"}], "]"}], "]"}], "^", "2"}]}]}], ",", 
             RowBox[{"VarianceEstimatorFunction", "\[Rule]", 
              RowBox[{"(", 
               RowBox[{"1", "&"}], ")"}]}]}], "]"}], "&"}], "/@", 
          "sample"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"qcrossSample", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", "/", 
              RowBox[{"lenlist", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ",", 
             RowBox[{
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Solve", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"qdfitSample", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", "x", "]"}], 
                    "\[Equal]", 
                    RowBox[{
                    RowBox[{"qdfitSample", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "3"}], "]"}], "]"}], "[", "x", "]"}]}], 
                   ",", "x"}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{";;", ",", "1", ",", "2"}], "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"#", "\[Element]", "Reals"}], 
                 RowBox[{"(*", 
                  RowBox[{"&&", 
                   RowBox[{
                   "0.3", "\[LessEqual]", "#", "\[LessEqual]", "0.8"}]}], 
                  "*)"}], "&"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"qfitSample", "=", 
         RowBox[{"NonlinearModelFit", "[", 
          RowBox[{"qcrossSample", ",", 
           RowBox[{"qc", "+", 
            RowBox[{"a", "*", 
             RowBox[{"x", "^", "\[Omega]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"qc", ",", "a", ",", "\[Omega]"}], "}"}], ",", "x"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"qcvalSample", "=", 
         RowBox[{
          RowBox[{"qfitSample", "[", "\"\<ParameterTableEntries\>\"", "]"}], 
          "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"md2Sample", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"md2lenlist", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"md2Interpol", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", "qcvalSample", "]"}]}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "md2lenlist", "]"}]}], "}"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"md2fitSample", "=", 
         RowBox[{
          RowBox[{"NonlinearModelFit", "[", 
           RowBox[{"md2Sample", ",", 
            RowBox[{"c", "+", 
             RowBox[{"a", "*", 
              RowBox[{"x", "^", 
               RowBox[{"-", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"2", "*", "\[CapitalDelta]"}], "-", "1"}], 
                 ")"}]}]}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"a", ",", 
              RowBox[{"{", 
               RowBox[{"\[CapitalDelta]", ",", "0.2"}], "}"}], ",", "c"}], 
             "}"}], ",", "x", ",", 
            RowBox[{"MaxIterations", "\[Rule]", "1000"}]}], "]"}], "//", 
          "Quiet"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"md2fitSample", "[", "\"\<ParameterTableEntries\>\"", "]"}], 
