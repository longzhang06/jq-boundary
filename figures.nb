              RowBox[{"[", "2", "]"}], "]"}], "\[LessEqual]", "0.3501"}], "&&", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "-", "0.315"}], "]"}], 
             "\[GreaterEqual]", "0.0001"}]}], ")"}], "&"}]}], "]"}], "&"}], "/@",
       "qdlist1"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DsSamples", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"shift", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
