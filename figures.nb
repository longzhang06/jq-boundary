Cell[BoxData[{
 RowBox[{
  RowBox[{"qcross", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"lenlist", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"qdfit", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", "x", "]"}], "\[Equal]", 
              RowBox[{
