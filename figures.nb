Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Resampling", " ", "procedure", " ", "to", " ", "estimate", " ", "the", 
    " ", "statistical", " ", "fluctuations"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"cplenlist", "=", 
     RowBox[{"Union", "@", 
      RowBox[{"cplist", "[", 
       RowBox[{"[", 
        RowBox[{";;", ",", "1"}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cplistlen", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"cplist", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
              RowBox[{"cplenlist", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "&&", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "\[GreaterEqual]", "18"}], "&&", 
             RowBox[{"0.2599", "<", 
