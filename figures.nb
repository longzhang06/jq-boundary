             RowBox[{";;", ",", ";;", ",", "4"}], "]"}], "]"}], "*", 
           "shift"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"qdfitSample", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"LinearModelFit", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
