               RowBox[{",", 
                RowBox[{"x", "^", "2"}]}], "*)"}], "}"}], ",", "x", ",", 
             RowBox[{"Weights", "\[Rule]", 
              RowBox[{"1", "/", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{";;", ",", "4"}], "]"}], "]"}], "^", "2"}]}]}], ",", 
             RowBox[{"VarianceEstimatorFunction", "\[Rule]", 
              RowBox[{"(", 
               RowBox[{"1", "&"}], ")"}]}]}], "]"}], "&"}], "/@", 
          "sample"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"qcrossSample", "=", 
         RowBox[{"Table", "[", 
