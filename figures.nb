          RowBox[{"(*", 
           RowBox[{",", 
            RowBox[{"x", "^", "4"}]}], "*)"}], "}"}], ",", "x", ",", 
         RowBox[{"Weights", "\[Rule]", 
          RowBox[{"1", "/", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "4"}], "]"}], "]"}], "^", "2"}]}]}], ",", 
